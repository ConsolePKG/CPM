{
  "name": "desktop",
  "private": true,
  "version": "1.0.0-beta.8",
  "productName": "PS4RPS",
  "description": "Remote pkg sender for PS4",
  "author": "njzy <njzydark@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/njzydark/PS4RPS.git"
  },
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "start": "electron . --remote-debugging-port=9223 --inspect=9224",
    "start:dev": "wait-on http://localhost:5173 dist/main/index.js && cross-env NODE_ENV=development RENDERER_DEV_PORT=5173 electronmon . --watch dist/main",
    "dev:main": "cross-env NODE_ENV=development rsbuild build --watch",
    "build": "cross-env NODE_ENV=production rsbuild build && pnpm run copyRenderer",
    "copyRenderer": "node scripts/copyRenderer.mjs",
    "tsc": "tsc --noEmit",
    "lint": "oxlint src --deny-warnings",
    "format:check": "oxfmt src --check",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder"
  },
  "build": {
    "extraMetadata": {
      "name": "PS4RPS"
    },
    "appId": "com.njzydark.ps4RPS",
    "productName": "PS4RPS",
    "directories": {
      "output": "output"
    },
    "files": [
      "dist",
      "node_modules"
    ],
    "publish": [
      "github"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.icns",
      "category": "Utility",
      "artifactName": "${productName}-${os}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@njzy/ps4-pkg-info": "workspace:^0.1.0",
    "axios": "1.20.0",
    "common": "workspace:^1.0.0-beta.8",
    "content-disposition": "0.5.4",
    "dotenv": "18.0.1",
    "electron-log": "catalog:",
    "electron-store": "catalog:",
    "fs-extra": "11.3.0",
    "get-folder-size": "5.0.0",
    "semver": "7.7.3",
    "serve-static": "2.2.0",
    "webdav-server": "2.6.2"
  },
  "devDependencies": {
    "@rsbuild/core": "catalog:",
    "cross-env": "10.1.0",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electronmon": "2.0.4",
    "infra-tools": "workspace:*",
    "typescript": "catalog:",
    "wait-on": "9.1.0"
  }
}
