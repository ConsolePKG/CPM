{
  "name": "@njzy/ps4-pkg-info",
  "version": "0.1.0",
  "description": "Get information (paramSfo and icon0) from a PlayStation 4 PKG file",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "src",
    "dist",
    "web",
    "package.json",
    "README.md",
    "tsconfig.json"
  ],
  "main": "dist/index.js",
  "exports": {
    "./web": {
      "import": "./web/index.mjs",
      "require": "./web/index.js",
      "types": "./types/web/index.d.ts"
    },
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./types/node/index.d.ts"
    }
  },
  "scripts": {
    "dev": "pnpm run dev:node & pnpm run dev:web",
    "build": "pnpm run build:node && pnpm run build:web",
    "build:node": "rslib build --config rslib.node.config.ts",
    "build:web": "rslib build --config rslib.web.config.ts",
    "dev:node": "rslib build --config rslib.node.config.ts --watch",
    "dev:web": "rslib build --config rslib.web.config.ts --watch",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "ps4",
    "pkg",
    "info",
    "paramSfo",
    "icon0"
  ],
  "author": "njzy",
  "license": "MIT",
  "dependencies": {
    "buffer": "^6.0.3",
    "python-struct": "^1.1.3"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@types/node": "catalog:",
    "@types/python-struct": "1.0.5",
    "infra-tools": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njzydark/PS4RPS.git"
  },
  "bugs": {
    "url": "https://github.com/njzydark/PS4RPS/issues"
  },
  "homepage": "https://github.com/njzydark/PS4RPS#readme",
  "publishConfig": {
    "access": "public"
  }
}
